{
  "name": "prettier-plugin-flix",
  "version": "0.1.1",
  "private": false,
  "description": "Prettier plugin for the Flix programming language (ANTLR4 parser, Prettier doc-IR printer)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wstein/prettier-plugin-flix.git"
  },
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "docs:build": "npm run build && node scripts/export-fixture-docs.mjs && hugo --source docs --minify && node --test scripts/check-playground.mjs",
    "docs:test:browser": "playwright test scripts/check-playground-browser.spec.mjs",
    "coverage:syntax": "node scripts/syntax-coverage.mjs",
    "format:checked": "node scripts/format-checked.mjs",
    "test:flix-format": "node scripts/flix-format-references.mjs",
    "test:update": "npm run build && UPDATE_FIXTURES=1 node --test test/fixtures.test.mjs",
    "test:docs-examples": "npm run build && node scripts/audit-flix-examples.mjs"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "antlr4ng": "3.0.16"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.65.1",
    "@shikijs/themes": "4.6.0",
    "@types/node": "24.10.1",
    "@wstein/flix-antlr-grammar": "github:wstein/flix-antlr-grammar#f8f711d32370bf2089b79e28d08d68f616a266b3",
    "antlr-ng": "1.0.10",
    "prettier": "3.10.1",
    "shiki": "4.6.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
