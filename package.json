{
  "name": "prettier-plugin-flix",
  "version": "0.2.0",
  "private": false,
  "description": "Prettier plugin for the Flix programming language (ANTLR4 parser, Prettier doc-IR printer)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wstein/prettier-plugin-flix.git"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "generate": "node scripts/generate.mjs",
    "build:rescript": "rescript && node scripts/copy-rescript.mjs",
    "build": "npm run generate && npm run build:rescript && tsc && cp types/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/*.{js,mjs}' --test-coverage-exclude='dist/FlixLexerBase.js' --test-coverage-lines=95 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov test/*.test.mjs",
    "docs:build": "npm run build && node scripts/export-fixture-docs.mjs && node scripts/build-docs-site.mjs && node --test scripts/check-playground.mjs",
    "docs:test:browser": "playwright test scripts/check-playground-browser.spec.mjs",
    "coverage:syntax": "node scripts/syntax-coverage.mjs",
    "format:checked": "node scripts/format-checked.mjs",
    "test:flix-format": "node scripts/flix-format-references.mjs",
    "review:sweep": "node scripts/review-sweep.mjs",
    "review:summary": "node scripts/review-summary.mjs",
    "review:pairs": "node scripts/comment-pairs.mjs",
    "review:kinds": "node scripts/comment-kinds-report.mjs",
    "review:rules": "node analysis/review-rules/run.mjs",
    "test:update": "npm run build && UPDATE_FIXTURES=1 node --test test/fixtures.test.mjs",
    "test:docs-examples": "npm run build && node scripts/audit-flix-examples.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "antlr4ng": "3.0.16"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.65.1",
    "@shikijs/themes": "4.6.0",
    "@types/node": "24.10.1",
    "@wstein/flix-antlr-grammar": "https://codeload.github.com/wstein/flix-antlr-grammar/tar.gz/1b63c89f3a7d1b2d3e69526be2abe4d1a29b14dd",
    "antlr-ng": "1.0.10",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "rescript": "12.3.1",
    "shiki": "4.6.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
